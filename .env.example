# Outbound Environment Configuration Example
# Copy to .env and fill in values

NODE_ENV=development

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_URL_DIRECT=postgresql://user:password@host:5432/database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PASSWORD=your-password

# Apollo API
APOLLO_API_KEY=your-apollo-key
APOLLO_BASE_URL=https://api.apollo.io/v1

# Sending Domain
OUTBOUND_SENDING_DOMAIN=example.com

# HubSpot
HUBSPOT_ACCESS_TOKEN=pat-na1-xxx
HUBSPOT_PORTAL_ID=12345678

# PartnerConnect API
PC_AUTH_URL=https://your-auth0-tenant.us.auth0.com/oauth/token
PC_CLIENT_ID=your-client-id
PC_CLIENT_SECRET=your-client-secret
PC_AUDIENCE=https://your-api.example.com
PC_API_BASE=https://your-api.example.com/v3/api

# Authentication (Fortium Identity integration)
# JWT_SECRET: Used for signing local session tokens (min 32 chars)
JWT_SECRET=change-this-to-a-secure-random-string-32-plus-chars

# COOKIE_SECRET: Used for signing cookies (min 32 chars)
COOKIE_SECRET=change-this-to-a-secure-random-string-32-plus-chars

# OIDC Configuration
# OIDC_ISSUER: Identity service URL with /oidc path
# Local dev: http://localhost:3099/oidc
# Docker: http://host.docker.internal:3099/oidc
# Production: https://identity.fortiumsoftware.com/oidc
OIDC_ISSUER=http://localhost:3099/oidc

# OIDC_CLIENT_ID: Must match the client registered in Identity
OIDC_CLIENT_ID=outbound-api

# Test Authentication (for E2E testing, Playwright, Claude automation)
# WARNING: Never enable in production!
ENABLE_TEST_AUTH=true
TEST_AUTH_KEY=your-secure-test-key-minimum-32-characters
